+static bool is_devfn_ignored_generic(const int devfn, const PCIBus *bus);
+
+static void pci_acpi_name(char *name, const PCIBus *bus, int devfn)
+{
+    char other_name[5];
+    bool present = bus->devices[devfn] != NULL;
+
+    get_mimic_pci_name(name, devfn);
+    for (int other = 0; other < ARRAY_SIZE(bus->devices); other++) {
+        bool other_present = bus->devices[other] &&
+                             !is_devfn_ignored_generic(other, bus);
+
+        if (other == devfn || (present && !other_present) ||
+            (present == other_present && other > devfn)) {
+            continue;
+        }
+        get_mimic_pci_name(other_name, other);
+        if (strcmp(other_name, name) == 0) {
+            snprintf(name, 5, "RP%02X", devfn);
+            return;
+        }
+    }
+}
